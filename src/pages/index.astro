---
import BaseLayout from '../layouts/BaseLayout.astro';
import Preloader from '../components/Preloader.astro';
import Cursor from '../components/Cursor.astro';
import Header from '../components/Header.astro';
import Menu from '../components/Menu.astro';
import Hero from '../components/Hero.astro';
import AboutRefugio from '../components/AboutRefugio.astro';
import SuiteChale from '../components/SuiteChale.astro';
import Amenities from '../components/Amenities.astro';
import Experience from '../components/Experience.astro';
import Gallery from '../components/Gallery.astro';
import Location from '../components/Location.astro';
import Reviews from '../components/Reviews.astro';
import BookingSection from '../components/BookingSection.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Preloader />
  <Cursor />
  <Header />
  <Menu />
  
  <div id="smoothWrap">
    <Hero />
    <AboutRefugio />
    <SuiteChale />
    <Amenities />
    <Experience />
    <Gallery />
    <Location />
    <Reviews />
    <BookingSection />
    <Faq />
    <Footer />
  </div>
</BaseLayout>
