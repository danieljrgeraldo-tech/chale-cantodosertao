---
---
<section class="gallery" id="galeria">
  <div class="gallery__head">
    <div>
      <p class="eyebrow reveal"><span>05</span> Galeria</p>
      <h2 class="section-title">
        <span class="line"><span class="line-inner">Cada canto,</span></span>
        <span class="line"><span class="line-inner">um <em>convite</em>.</span></span>
      </h2>
    </div>
    <p class="gallery__hint reveal">Clique e mergulhe <span>↗</span></p>
  </div>

  <div class="gallery__grid" id="galleryGrid">
    <a class="g-item g-item--tall" href="/images/chale-1.webp" data-caption="Fachada A-frame com vitral e lustre interno" data-cursor="gallery" data-parallax="0.05"><img src="/images/chale-1.webp" alt="Fachada A-frame do chalé" loading="lazy"><span class="g-item__tag">Fachada A-frame</span></a>
    <a class="g-item" href="/images/chale-2.webp" data-caption="Banheira quente com iluminação LED azul e vista noturna" data-cursor="gallery" data-parallax="0.04"><img src="/images/chale-2.webp" alt="Banheira quente com LED azul à noite" loading="lazy"><span class="g-item__tag">Banheira à noite</span></a>
    <a class="g-item" href="/images/chale-3.webp" data-caption="Vista geral do deck, chalé e área da banheira" data-cursor="gallery" data-parallax="0.05"><img src="/images/chale-3.webp" alt="Deck e exterior do chalé" loading="lazy"><span class="g-item__tag">Deck & Exterior</span></a>
    <a class="g-item" href="/images/chale-4.webp" data-caption="Fachada iluminada do chalé ao anoitecer" data-cursor="gallery" data-parallax="0.04"><img src="/images/chale-4.webp" alt="Chalé iluminado à noite" loading="lazy"><span class="g-item__tag">Fachada Noturna</span></a>
    <a class="g-item g-item--wide" href="/images/chale-5.webp" data-caption="Dormitório acolhedor no mezanino com lustre de cristal" data-cursor="gallery" data-parallax="0.06"><img src="/images/chale-5.webp" alt="Cama no mezanino" loading="lazy"><span class="g-item__tag">Dormitório</span></a>
    <a class="g-item" href="/images/chale-6.webp" data-caption="Mesa de jantar e kitchenette completa" data-cursor="gallery" data-parallax="0.05"><img src="/images/chale-6.webp" alt="Mesa de jantar e kitchenette" loading="lazy"><span class="g-item__tag">Kitchenette</span></a>
    <a class="g-item" href="/images/chale-7.webp" data-caption="Lustre clássico de cristal em detalhes" data-cursor="gallery" data-parallax="0.04"><img src="/images/chale-7.webp" alt="Lustre clássico de cristal" loading="lazy"><span class="g-item__tag">Lustre de Cristal</span></a>
    <a class="g-item" href="/images/chale-8.webp" data-caption="Arquitetura A-frame refletindo a natureza ao redor" data-cursor="gallery" data-parallax="0.05"><img src="/images/chale-8.webp" alt="Estrutura A-frame em vidro" loading="lazy"><span class="g-item__tag">Arquitetura</span></a>
    <a class="g-item g-item--tall" href="/images/chale-9.webp" data-caption="Vista panorâmica do pôr do sol no deck" data-cursor="gallery" data-parallax="0.06"><img src="/images/chale-9.webp" alt="Pôr do sol visto do deck" loading="lazy"><span class="g-item__tag">Pôr do Sol</span></a>
    <a class="g-item" href="/images/chale-10.webp" data-caption="Banheira de hidromassagem aquecida com vista panorâmica" data-cursor="gallery" data-parallax="0.04"><img src="/images/chale-10.webp" alt="Hidromassagem com vista para a mata" loading="lazy"><span class="g-item__tag">Hidromassagem</span></a>
    <a class="g-item" href="/images/chale-11.webp" data-caption="Estrutura envidraçada do espaço da banheira no deck" data-cursor="gallery" data-parallax="0.05"><img src="/images/chale-11.webp" alt="Pergolado envidraçado da banheira" loading="lazy"><span class="g-item__tag">Espaço Banheira</span></a>
    <a class="g-item" href="/images/chale-12.webp" data-caption="Corredor interno com iluminação em LED e madeira rústica" data-cursor="gallery" data-parallax="0.04"><img src="/images/chale-12.webp" alt="Corredor interno com LED" loading="lazy"><span class="g-item__tag">Ambiente Interno</span></a>
    <a class="g-item g-item--wide" href="/images/chale-13.webp" data-caption="Varanda em deck com poltronas confortáveis e vista para o vale" data-cursor="gallery" data-parallax="0.06"><img src="/images/chale-13.webp" alt="Varanda com poltronas e vista para o vale" loading="lazy"><span class="g-item__tag">Varanda & Vista</span></a>
    <a class="g-item" href="/images/chale-14.webp" data-caption="Banheiro privativo completo com box de vidro e chuveiro moderno" data-cursor="gallery" data-parallax="0.05"><img src="/images/chale-14.webp" alt="Banheiro privativo" loading="lazy"><span class="g-item__tag">Banheiro</span></a>
    <a class="g-item" href="/images/chale-15.webp" data-caption="Sala de estar integrada com jantar, kitchenette e mezanino" data-cursor="gallery" data-parallax="0.04"><img src="/images/chale-15.webp" alt="Sala de estar e ambiente integrado" loading="lazy"><span class="g-item__tag">Sala & Estar</span></a>
    <a class="g-item" href="/images/chale-16.webp" data-caption="Banheira aquecida com água cristalina sob a estrutura de vidro" data-cursor="gallery" data-parallax="0.05"><img src="/images/chale-16.webp" alt="Banheira de hidromassagem cristalina" loading="lazy"><span class="g-item__tag">Relaxamento</span></a>
    <a class="g-item" href="/images/chale-17.webp" data-caption="Sol da tarde iluminando o pergolado da banheira quente" data-cursor="gallery" data-parallax="0.04"><img src="/images/chale-17.webp" alt="Banheira ensolarada à tarde" loading="lazy"><span class="g-item__tag">Banheira Ensolarada</span></a>
    <a class="g-item g-item--tall" href="/images/chale-18.webp" data-caption="Destaque para o lustre de cristal e a vista para o deck" data-cursor="gallery" data-parallax="0.06"><img src="/images/chale-18.webp" alt="Lustre de cristal em destaque" loading="lazy"><span class="g-item__tag">Detalhe Lustre</span></a>
  </div>
</section>

<div class="lightbox" id="lightbox" aria-hidden="true">
  <button class="lightbox__close" id="lightboxClose" aria-label="Fechar" data-cursor="link">✕</button>
  <button class="lightbox__nav lightbox__nav--prev" id="lightboxPrev" aria-label="Anterior" data-cursor="link">←</button>
  <figure class="lightbox__stage">
    <img src="" alt="" id="lightboxImg">
    <figcaption id="lightboxCaption"></figcaption>
  </figure>
  <button class="lightbox__nav lightbox__nav--next" id="lightboxNext" aria-label="Próxima" data-cursor="link">→</button>
  <div class="lightbox__count" id="lightboxCount"></div>
</div>
