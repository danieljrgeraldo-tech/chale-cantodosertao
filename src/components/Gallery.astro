---
---
<section class="gallery" id="galeria">
  <div class="gallery__head">
    <div>
      <p class="eyebrow reveal"><span>05</span> Galeria</p>
      <h2 class="section-title">
        <span class="line"><span class="line-inner">Cada canto,</span></span>
        <span class="line"><span class="line-inner">um <em>convite</em>.</span></span>
      </h2>
    </div>
    <p class="gallery__hint reveal">Clique e mergulhe <span>↗</span></p>
  </div>

  <div class="gallery__grid" id="galleryGrid">
    <a class="g-item g-item--tall" href="/images/chale-1.webp" data-caption="O quarto, onde tudo começa" data-cursor="gallery" data-parallax="0.05"><img src="/images/chale-1.webp" alt="Quarto do chalé" loading="lazy"><span class="g-item__tag">O quarto</span></a>
    <a class="g-item" href="/images/chale-2.webp" data-caption="Detalhes que fazem a diferença" data-cursor="gallery" data-parallax="0.04"><img src="/images/chale-2.webp" alt="Detalhes do chalé" loading="lazy"><span class="g-item__tag">Detalhes</span></a>
    <a class="g-item" href="/images/chale-3.webp" data-caption="Cozinha e acolhimento" data-cursor="gallery" data-parallax="0.05"><img src="/images/chale-3.webp" alt="Cozinha do chalé" loading="lazy"><span class="g-item__tag">Cozinha</span></a>
    <a class="g-item" href="/images/chale-4.webp" data-caption="A luz do sertão entra por aqui" data-cursor="gallery" data-parallax="0.04"><img src="/images/chale-4.webp" alt="Luz natural no chalé" loading="lazy"><span class="g-item__tag">Luz natural</span></a>
    <a class="g-item g-item--wide" href="/images/chale-5.webp" data-caption="Áreas de convivência" data-cursor="gallery" data-parallax="0.06"><img src="/images/chale-5.webp" alt="Áreas de convivência do chalé" loading="lazy"><span class="g-item__tag">Convivência</span></a>
    <a class="g-item" href="/images/chale-6.webp" data-caption="Cada canto tem sua história" data-cursor="gallery" data-parallax="0.05"><img src="/images/chale-6.webp" alt="Canto do chalé" loading="lazy"><span class="g-item__tag">Cantos</span></a>
    <a class="g-item" href="/images/chale-7.webp" data-caption="O chalé e o seu cenário" data-cursor="gallery" data-parallax="0.04"><img src="/images/chale-7.webp" alt="Exterior do chalé" loading="lazy"><span class="g-item__tag">O chalé</span></a>
    <a class="g-item" href="/images/chale-8.webp" data-caption="Momentos a dois" data-cursor="gallery" data-parallax="0.05"><img src="/images/chale-8.webp" alt="Momento a dois no chalé" loading="lazy"><span class="g-item__tag">A dois</span></a>
    <a class="g-item g-item--tall" href="/images/chale-9.webp" data-caption="Toques rústicos" data-cursor="gallery" data-parallax="0.06"><img src="/images/chale-9.webp" alt="Toques rústicos do chalé" loading="lazy"><span class="g-item__tag">Rústico</span></a>
    <a class="g-item" href="/images/chale-10.webp" data-caption="Aconchego em cada detalhe" data-cursor="gallery" data-parallax="0.04"><img src="/images/chale-10.webp" alt="Aconchego do chalé" loading="lazy"><span class="g-item__tag">Aconchego</span></a>
    <a class="g-item" href="/images/chale-11.webp" data-caption="Noites para lembrar" data-cursor="gallery" data-parallax="0.05"><img src="/images/chale-11.webp" alt="Noites no chalé" loading="lazy"><span class="g-item__tag">Noites</span></a>
    <a class="g-item" href="/images/chale-12.webp" data-caption="Pequenos refúgios" data-cursor="gallery" data-parallax="0.04"><img src="/images/chale-12.webp" alt="Pequenos refúgios no chalé" loading="lazy"><span class="g-item__tag">Refúgios</span></a>
    <a class="g-item g-item--wide" href="/images/chale-13.webp" data-caption="Sabor de casa" data-cursor="gallery" data-parallax="0.06"><img src="/images/chale-13.webp" alt="Cozinha do chalé" loading="lazy"><span class="g-item__tag">Sabor de casa</span></a>
    <a class="g-item" href="/images/chale-14.webp" data-caption="Descanso e serenidade" data-cursor="gallery" data-parallax="0.05"><img src="/images/chale-14.webp" alt="Descanso no chalé" loading="lazy"><span class="g-item__tag">Descanso</span></a>
    <a class="g-item" href="/images/chale-15.webp" data-caption="A varanda dos encontros" data-cursor="gallery" data-parallax="0.04"><img src="/images/chale-15.webp" alt="Varanda do chalé" loading="lazy"><span class="g-item__tag">Varanda</span></a>
    <a class="g-item" href="/images/chale-16.webp" data-caption="Entre a mata e o horizonte" data-cursor="gallery" data-parallax="0.05"><img src="/images/chale-16.webp" alt="Chalé entre mata e horizonte" loading="lazy"><span class="g-item__tag">Natureza</span></a>
    <a class="g-item" href="/images/chale-17.webp" data-caption="O quintal do sertão" data-cursor="gallery" data-parallax="0.04"><img src="/images/chale-17.webp" alt="Jardim do chalé" loading="lazy"><span class="g-item__tag">Jardim</span></a>
    <a class="g-item g-item--tall" href="/images/chale-18.webp" data-caption="O Canto do Sertão, inteiro" data-cursor="gallery" data-parallax="0.06"><img src="/images/chale-18.webp" alt="Vista geral do Chalé Canto do Sertão" loading="lazy"><span class="g-item__tag">Vista geral</span></a>
  </div>
</section>

<div class="lightbox" id="lightbox" aria-hidden="true">
  <button class="lightbox__close" id="lightboxClose" aria-label="Fechar" data-cursor="link">✕</button>
  <button class="lightbox__nav lightbox__nav--prev" id="lightboxPrev" aria-label="Anterior" data-cursor="link">←</button>
  <figure class="lightbox__stage">
    <img src="" alt="" id="lightboxImg">
    <figcaption id="lightboxCaption"></figcaption>
  </figure>
  <button class="lightbox__nav lightbox__nav--next" id="lightboxNext" aria-label="Próxima" data-cursor="link">→</button>
  <div class="lightbox__count" id="lightboxCount"></div>
</div>
